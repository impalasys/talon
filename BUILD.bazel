bool_flag(
    name = "with_cpu_profile",
    build_setting_default = False,
)

bool_flag(
    name = "with_heap_profile",
    build_setting_default = False,
)

config_setting(
    name = "cpu-profile",
    flag_values = {":with_cpu_profile": "true"},
)

config_setting(
    name = "heap-profile",
    flag_values = {":with_heap_profile": "true"},
)

js_library(
    name = "proto_js",
    srcs = [":proto_sources"],
    visibility = ["//visibility:public"],
)

# Configured CI discovery must filter host-incompatible targets before selection.
platform(
