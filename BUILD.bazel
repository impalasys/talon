load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_deps")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test", "rustfmt_test")
load("//scripts/sdk:codegen.bzl", "SDK_PROTO_SOURCES")
load("//tools/bazel:production.bzl", "production_filegroup")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".bazelignore",
    ".bazelversion",
])

npm_link_all_packages(name = "node_modules")

config_setting(
    name = "aws",
    flag_values = {":with_aws": "true"},
)

config_setting(
    name = "rocksdb",
    flag_values = {":with_rocksdb": "true"},
)

_FEATURES = select({
    ":aws": ["aws"],
    "//conditions:default": [],
}) + select({
    ":rocksdb": ["rocksdb"],
    "//conditions:default": [],
})

_FEATURES += select({
    ":cpu-profile": ["cpu-profile"],
    "//conditions:default": [],
}) + select({
    ":heap-profile": ["heap-profile"],
    "//conditions:default": [],
})

_RUNTIME_DEPS = all_crate_deps(normal = True)

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
)

filegroup(
    name = "internal_proto_sources",
    srcs = glob([
        "proto/**/*.proto",
        "third_party/googleapis/**/*.proto",
    ]),
)

filegroup(
    name = "runtime_data",
    srcs = glob(["models/**/*.yaml"]) + [
        "models.yaml",
        "talon.docker-compose.yaml",
        "talon.yaml",
    ],
)

rust_library(
    name = "talon",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/*.rs"],
    ),
    aliases = aliases(),
    compile_data = glob(
        ["src/**/testdata/**"],
        allow_empty = True,
    ) + [
        "proto/resources.toml",
        "src/control/security/test_rsa_private_key.pem",
        ":runtime_data",
    ],
    crate_features = _FEATURES,
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    rustc_env_files = [":cargo_env"],
    deps = [
        "//crates/auth:auth",
        "//crates/config:config",
        "//crates/connectors:connectors",
        "//crates/fanout:fanout",
        "//crates/identifiers:identifiers",
        "//crates/protocol:protocol",
        "//crates/sandbox:sandbox",
        "//crates/security:security",
        "//crates/session-control:session_control",
        "//crates/workflows:workflows",
        "//crates/bootstrap:bootstrap",
        "//crates/cli:cli",
        "//crates/contracts:contracts",
        "//crates/control:control",
        "//crates/gateway:gateway",
        "//crates/harness:harness",
        "//crates/monty:monty",
        "//crates/observability:observability",
        "//crates/storage-cloud-tasks:storage_cloud_tasks",
        "//crates/storage-common:storage_common",
        "//crates/storage-memory:storage_memory",
        "//crates/storage-objects:storage_objects",
        "//crates/storage-postgres:storage_postgres",
        "//crates/storage-pubsub:storage_pubsub",
        "//crates/storage-sqlite:storage_sqlite",
        "//crates/test-support:test_support",
        "//crates/worker:worker",
    ] + select({
        "//:aws": [
            "//crates/storage-dynamodb:storage_dynamodb",
            "//crates/storage-eventbridge:storage_eventbridge",
            "//crates/storage-sqs:storage_sqs",
        ],
        "//conditions:default": [],
    }) + select({
        "//:rocksdb": ["//crates/storage-rocksdb:storage_rocksdb"],
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "talon-server",
    srcs = ["src/bin/server.rs"],
    aliases = aliases(),
    compile_data = ["src/control/security/test_rsa_private_key.pem"],
    crate_features = _FEATURES,
    crate_name = "talon_server",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = crate_deps([
        "anyhow",
        "tokio",
        "tokio-util",
        "tracing",
    ]) + [
        "//crates/auth:auth",
        "//crates/bootstrap:bootstrap",
        "//crates/config:config",
        "//crates/control:control",
        "//crates/gateway:gateway",
        "//crates/monty:monty",
        "//crates/observability:observability",
        "//crates/security:security",
    ] + select({
        "//:heap-profile": crate_deps(
            ["tikv-jemallocator"],
            package_name = "tools/bazel",
        ),
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "talon-worker",
    srcs = ["src/bin/worker.rs"],
    aliases = aliases(),
    compile_data = ["src/control/security/test_rsa_private_key.pem"],
    crate_features = _FEATURES,
    crate_name = "talon_worker",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = crate_deps([
        "anyhow",
        "axum",
        "base64",
        "chrono",
        "futures",
        "google-cloud-pubsub",
        "hyper",
        "hyper-util",
        "prost",
        "serde",
        "serde_json",
        "tokio",
        "tokio-util",
        "tonic",
        "tower",
        "tracing",
        "url",
        "urlencoding",
    ]) + [
        "//crates/bootstrap:bootstrap",
        "//crates/config:config",
        "//crates/contracts:contracts",
        "//crates/control:control",
        "//crates/monty:monty",
        "//crates/observability:observability",
        "//crates/protocol:protocol",
        "//crates/security:security",
        "//crates/storage-pubsub:storage_pubsub",
        "//crates/worker:worker",
    ] + select({
        "//:aws": ["//crates/storage-sqs:storage_sqs"] + crate_deps(
            ["aws-sdk-sqs"],
            package_name = "tools/bazel",
        ),
        "//conditions:default": [],
    }) + select({
        "//:heap-profile": crate_deps(
            ["tikv-jemallocator"],
            package_name = "tools/bazel",
        ),
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "talon-cli",
    srcs = ["src/bin/cli.rs"],
    aliases = aliases(),
    compile_data = ["src/control/security/test_rsa_private_key.pem"],
    crate_features = _FEATURES,
    crate_name = "talon_cli",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = crate_deps([
        "anyhow",
        "tokio",
    ]) + ["//crates/cli:cli"],
)

rust_binary(
    name = "talon-node",
    srcs = ["src/bin/node.rs"],
    aliases = aliases(),
    compile_data = ["src/control/security/test_rsa_private_key.pem"],
    crate_features = _FEATURES,
    crate_name = "talon_node",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = crate_deps([
        "anyhow",
        "futures",
        "tempfile",
        "tokio",
        "tokio-stream",
        "tokio-util",
        "tonic",
        "tracing",
        "url",
        "urlencoding",
    ]) + [
        "//crates/auth:auth",
        "//crates/bootstrap:bootstrap",
        "//crates/config:config",
        "//crates/control:control",
        "//crates/gateway:gateway",
        "//crates/monty:monty",
        "//crates/observability:observability",
        "//crates/protocol:protocol",
        "//crates/security:security",
        "//crates/worker:worker",
    ] + select({
        "//:heap-profile": crate_deps(
            ["tikv-jemallocator"],
            package_name = "tools/bazel",
        ),
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "talon-mock-acp",
    srcs = ["//tests:fixtures/mock_acp.rs"],
    edition = "2021",
    rustc_env_files = [":cargo_env"],
    deps = crate_deps(
        [
            "anyhow",
            "serde",
            "serde_json",
            "tokio",
        ],
    ),
)

filegroup(
    name = "binaries",
    srcs = [
        ":talon-cli",
        ":talon-node",
        ":talon-server",
        ":talon-worker",
    ],
)

rust_test(
    name = "identifiers_compat_test",
    crate_features = _FEATURES,
    srcs = ["//tests:identifiers_compat.rs"],
    edition = "2021",
    deps = [
        ":talon",
        "//crates/identifiers:identifiers",
    ],
)

rust_test(
    name = "talon_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":talon",
    crate_features = _FEATURES,
    data = [":runtime_data"],
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    tags = [
        "no-remote-exec",
        "requires-docker",
    ],
    deps = all_crate_deps(
        normal_dev = True,
    ),
)

[
    rust_test(
        name = name + "_test",
        srcs = ["//tests:" + name + ".rs"],
        aliases = aliases(
            normal_dev = True,
            proc_macro_dev = True,
        ),
        compile_data = ["src/control/security/test_rsa_private_key.pem"],
        data = [
            ":talon-mock-acp",
            ":talon-node",
            ":talon-server",
            ":talon-worker",
        ],
        edition = "2021",
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        rustc_env = {
            "CARGO_BIN_EXE_talon-server": "./$(rootpath :talon-server)",
            "CARGO_BIN_EXE_talon-worker": "./$(rootpath :talon-worker)",
            "CARGO_BIN_EXE_talon-node": "./$(rootpath :talon-node)",
            "CARGO_BIN_EXE_talon-mock-acp": "./$(rootpath :talon-mock-acp)",
        },
        deps = _RUNTIME_DEPS + all_crate_deps(
            normal_dev = True,
        ) + [":talon"],
    )
    for name in [
        "mock_acp_cli",
        "monty_embedded",
        "postgres_tls_startup",
    ]
]

_BIN_TEST_DEPS = {
    "server": [
        "//crates/test-support:test_support",
    ],
    "worker": [
        "//crates/test-support:test_support",
    ],
    "cli": [],
    "node": [
        "//crates/test-support:test_support",
    ],
}

# Cargo also runs unit tests declared inside each binary.
[
    rust_test(
        name = "talon_" + name + "_test",
        aliases = aliases(
            normal_dev = True,
            proc_macro_dev = True,
        ),
        crate = ":talon-" + name,
        crate_features = _FEATURES,
        edition = "2021",
        proc_macro_deps = all_crate_deps(
            proc_macro_dev = True,
        ),
        deps = all_crate_deps(
            normal_dev = True,
        ) + _BIN_TEST_DEPS[name],
    )
    for name in [
        "server",
        "worker",
        "cli",
        "node",
    ]
]

production_filegroup(
    name = "production_binaries",
    srcs = [":binaries"],
)

production_filegroup(
    name = "benchmark_binaries",
    srcs = [
        ":talon-cli",
        ":talon-node",
    ],
)

production_filegroup(
    name = "e2e_binaries",
    srcs = [":binaries"],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

# Runtime releases and node SDK packages deliberately use different platform names.
_RUNTIME_PLATFORM = select({
    ":linux_x86_64": "linux-x86_64",
    ":linux_arm64": "linux-aarch64",
    ":darwin_arm64": "darwin-arm64",
    "//conditions:default": "darwin-x86_64",
})

_SDK_PLATFORM = select({
    ":linux_x86_64": "linux-x64",
    ":linux_arm64": "linux-arm64",
    ":darwin_arm64": "darwin-arm64",
    "//conditions:default": "darwin-x64",
})

pkg_files(
    name = "release-dist_binaries",
    srcs = [":production_binaries"],
    attributes = pkg_attributes(mode = "0755"),
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "release-dist_configs",
    srcs = [":runtime_data"],
    attributes = pkg_attributes(mode = "0644"),
    strip_prefix = strip_prefix.from_root(),
)

pkg_tar(
    name = "release-dist_payload",
    srcs = [
        ":release-dist_binaries",
        ":release-dist_configs",
    ],
)

genrule(
    name = "release-dist_checksums",
    srcs = [":release-dist_payload"],
    outs = ["release-dist/SHA256SUMS"],
    cmd = "$(execpath //tools/bazel:checksums) contents $(location :release-dist_payload) $@",
    tools = ["//tools/bazel:checksums"],
)

pkg_tar(
    name = "release-dist_runtime",
    srcs = [":release-dist_checksums"],
    extension = "tar.gz",
    mode = "0644",
    package_dir = "talon-" + _RUNTIME_PLATFORM,
    package_file_name = "release-dist/talon-" + _RUNTIME_PLATFORM + ".tar.gz",
    deps = [":release-dist_payload"],
)

select_file(
    name = "release-dist_node_binary",
    srcs = ":production_binaries",
    subpath = "talon-node",
)

pkg_files(
    name = "release-dist_node_files",
    srcs = [":release-dist_node_binary"],
    attributes = pkg_attributes(mode = "0755"),
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "release-dist_node",
    srcs = [":release-dist_node_files"],
    extension = "tar.gz",
    mode = "0644",
    package_dir = "talon-node-" + _SDK_PLATFORM,
    package_file_name = "release-dist/talon-node-" + _SDK_PLATFORM + ".tar.gz",
)

genrule(
    name = "release-dist_node_checksum",
    srcs = [":release-dist_node"],
    outs = ["release-dist/node.sha256"],
    cmd = "$(execpath //tools/bazel:checksums) archive $(location :release-dist_node) $@",
    tools = ["//tools/bazel:checksums"],
)

filegroup(
    name = "release-dist",
    # Preserve the established aggregate output order.
    srcs = [
        # do not sort
        ":release-dist_runtime",
        ":release-dist_node",
        ":release-dist_node_checksum",
        ":release-dist_checksums",
    ],
)

filegroup(
    name = "proto_sources",
    srcs = glob([
        "proto/**",
        "third_party/**",
    ]),
)

proto_library(
    name = "sdk_struct_proto",
    srcs = ["third_party/googleapis/google/protobuf/struct.proto"],
    strip_import_prefix = "third_party/googleapis",
)

proto_library(
    name = "sdk_protos",
    srcs = SDK_PROTO_SOURCES,
    deps = [":sdk_struct_proto"],
)

filegroup(
    name = "test_fixtures",
    srcs = ["src/control/security/test_rsa_private_key.pem"] + glob(["models/**"]) + [
        "models.yaml",
        "talon.docker-compose.yaml",
        "talon.yaml",
    ],
)

bool_flag(
    name = "with_aws",
    build_setting_default = False,
)

bool_flag(
    name = "with_rocksdb",
    build_setting_default = False,
)

filegroup(
    name = "cli_sources",
    srcs = ["//crates/cli:cli_sources"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_tests",
    crate = ":talon",
)

