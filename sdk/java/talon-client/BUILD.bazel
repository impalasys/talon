load("@rules_java//java:defs.bzl", "java_test")
load("@rules_jvm_external//:defs.bzl", "java_export")
load("//sdk:version.bzl", "SDK_VERSION")

java_export(
    name = "talon_client",
    srcs = glob(["src/main/java/**/*.java"]),
    maven_coordinates = "systems.impala:talon-client:" + SDK_VERSION,
    resources = glob(
        ["src/main/resources/**"],
        allow_empty = True,
    ),
    tags = ["no-javadocs"],
    visibility = ["//visibility:public"],
    exports = [
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_protobuf",
        "@maven//:io_grpc_grpc_stub",
    ],
    deps = [
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_protobuf",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:org_apache_tomcat_annotations_api",
    ],
)

java_test(
    name = "unit_tests",
    srcs = glob(["src/test/java/**/*.java"]),
    args = [
        "execute",
        "--select-class=systems.impala.talon.client.GeneratedTypesTest",
        "--fail-if-no-tests",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    runtime_deps = ["@maven//:org_junit_platform_junit_platform_console_standalone"],
    deps = [
        ":talon_client",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

filegroup(
    name = "generated_sources",
    srcs = glob([
        "src/main/java/talon/**",
        "src/main/java/systems/impala/talon/client/TalonClientset.java",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "generated_metadata",
    srcs = glob(
        include = ["src/main/java/talon/**"],
        allow_empty = True,
        exclude = ["**/*.java"],
    ),
    visibility = ["//visibility:public"],
)
