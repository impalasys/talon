{
  "name": "@impalasys/talon-node-linux-x64",
  "version": "0.2.11",
  "description": "Linux x86_64 talon-node binary",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impalasys/talon.git",
    "directory": "sdk/js/talon-node-linux-x64"
  },
  "os": ["linux"],
  "cpu": ["x64"],
  "files": ["bin", "index.js"],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "bin/talon-node"
    ]
  },
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').accessSync('bin/talon-node', require('node:fs').constants.X_OK)\""
  }
}
