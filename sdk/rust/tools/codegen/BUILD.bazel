load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "codegen",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/protocol",
        build = True,
    ),
)

rust_test(
    name = "unit_tests",
    crate = ":codegen",
    edition = "2021",
)
