load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "talon_client",
    srcs = glob(["src/**/*.py"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("grpcio"),
        requirement("protobuf"),
    ],
)

py_test(
    name = "unit_tests",
    srcs = ["//tools/bazel:pytest_main.py"] + glob(["tests/**/*.py"]),
    args = ["sdk/python/talon-client/tests"],
    main = "//tools/bazel:pytest_main.py",
    deps = [
        ":talon_client",
        requirement("pytest"),
    ],
)

filegroup(
    name = "package_sources",
    srcs = glob(
        [
            "src/**",
            "README.md",
            "pyproject.toml",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
    visibility = ["//visibility:public"],
)

# Use the same upstream backend and package metadata as a normal Python build.
run_binary(
    name = "dist",
    srcs = [":package_sources"],
    args = [
        "build",
        "-t",
        "wheel",
        "-t",
        "sdist",
        "-d",
        "../../../$@",
    ],
    chdir = "sdk/python/talon-client",
    env = {"SOURCE_DATE_EPOCH": "315532800"},
    out_dirs = ["dist"],
    tool = "//tools/bazel:hatchling",
    visibility = ["//visibility:public"],
)

exports_files(["pyproject.toml"])

filegroup(
    name = "generated_sources",
    srcs = glob(["src/talon_client/**"]),
    visibility = ["//visibility:public"],
)
