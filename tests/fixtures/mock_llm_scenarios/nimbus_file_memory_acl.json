{
  "rules": [
    {
      "id": "carlson_file_create",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local file create",
      "tool_name": "create_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_create",
        "tool_name": "create_file",
        "content": "Creating the Carlson test File. ",
        "arguments": {
          "path": "/local-tests/carlson-file.md",
          "content": "Carlson local File version 1"
        }
      }
    },
    {
      "id": "carlson_file_read",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local file read",
      "tool_name": "read_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_read",
        "tool_name": "read_file",
        "content": "Reading the Carlson test File. ",
        "arguments": {
          "path": "/local-tests/carlson-file.md"
        }
      }
    },
    {
      "id": "carlson_file_update",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local file update",
      "tool_name": "update_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_update",
        "tool_name": "update_file",
        "content": "Updating the Carlson test File. ",
        "arguments": {
          "path": "/local-tests/carlson-file.md",
          "content": "Carlson local File version 2"
        }
      }
    },
    {
      "id": "carlson_file_list",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local file list",
      "tool_name": "list_files",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_list",
        "tool_name": "list_files",
        "content": "Listing Carlson test Files. ",
        "arguments": {
          "prefix": "/local-tests"
        }
      }
    },
    {
      "id": "carlson_file_delete_request",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local file delete",
      "tool_name": "delete_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_delete_request",
        "tool_name": "delete_file",
        "content": "Preparing the Carlson File deletion request. ",
        "arguments": {
          "path": "/local-tests/carlson-file.md"
        }
      }
    },
    {
      "id": "carlson_file_delete_confirm",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "confirm delete file file://tenant:nimbus-local:carlson/local-tests/carlson-file.md",
      "tool_name": "delete_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_file_delete_confirm",
        "tool_name": "delete_file",
        "content": "Using the separate exact confirmation. ",
        "arguments": {
          "path": "/local-tests/carlson-file.md",
          "confirmation_id": "{{confirmation_id}}"
        }
      }
    },
    {
      "id": "carlson_kevin_file_create",
      "system_contains": "carlson nimbus local file acl test",
      "last_message_contains": "local kevin file create",
      "tool_name": "create_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_carlson_kevin_file_create",
        "tool_name": "create_file",
        "content": "Creating a File in the explicitly requested Kevin test namespace. ",
        "arguments": {
          "namespace": "Tenant:nimbus-local:kevin",
          "path": "/local-tests/from-carlson.md",
          "content": "Created by Carlson Nimbus through the explicit Kevin allowlist"
        }
      }
    },
    {
      "id": "kevin_file_create",
      "system_contains": "kevin nimbus local file acl test",
      "last_message_contains": "local file create",
      "tool_name": "create_file",
      "response": {
        "type": "tool_call",
        "tool_call_id": "call_kevin_file_create",
        "tool_name": "create_file",
        "content": "Creating the Kevin test File. ",
        "arguments": {
          "path": "/local-tests/kevin-file.md",
          "content": "Kevin local File version 1"
        }
      }
    },
    {
      "id": "kevin_carlson_read_denied",
      "system_contains": "kevin nimbus local file acl test",
      "last_message_contains": "local carlson read attempt",
      "tool_name": "read_file",
