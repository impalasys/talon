load("@pypi//:requirements.bzl", "requirement", "whl_requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:artifacts.bzl", "container_context")
load("//tools/bazel:configured_files.bzl", "linux_files")
load("//tools/bazel:image_layer.bzl", "debian_layer", "image_layer")

package(default_visibility = ["//visibility:public"])

PYTHON_BASE = select({
    "@platforms//cpu:aarch64": "@python_base_linux_arm64_v8//:python_base_linux_arm64_v8",
    "//conditions:default": "@python_base_linux_amd64//:python_base_linux_amd64",
})

NGINX_BASE = select({
    "@platforms//cpu:aarch64": "@nginx_base_linux_arm64_v8//:nginx_base_linux_arm64_v8",
    "//conditions:default": "@nginx_base_linux_amd64//:nginx_base_linux_amd64",
})

LINUX = ["@platforms//os:linux"]

image_layer(
    name = "runtime_binaries",
    binaries = "//:production_binaries",
    target_compatible_with = LINUX,
)

image_layer(
    name = "benchmark_binaries",
    binaries = "//:benchmark_binaries",
    target_compatible_with = LINUX,
)

image_layer(
    name = "runtime_configs",
    configs = "//:runtime_data",
)

alias(
    name = "docker_cli",
    actual = select({
        "@platforms//cpu:aarch64": "@docker_cli_aarch64//:docker/docker",
        "//conditions:default": "@docker_cli_x86_64//:docker/docker",
    }),
)

image_layer(
    name = "docker_cli_layer",
    files = {":docker_cli": "usr/local/bin/docker"},
)

image_layer(
    name = "python_tools",
    monty_whl = whl_requirement("pydantic-monty-runtime"),
    python_packages = [
        "//tests:support",
    ],
    target_compatible_with = LINUX,
)

oci_image(
    name = "runtime_base",
    base = PYTHON_BASE,
    target_compatible_with = LINUX,
    tars = [
        ":runtime_os",
        ":python_tools",
        ":docker_cli_layer",
    ],
)

linux_files(
    name = "runtime_base_linux_amd64",
    tags = ["manual"],
    targets = [":runtime_base"],
)

oci_load(
    name = "runtime_base_image",
    image = ":runtime_base_linux_amd64",
    repo_tags = ["talon-runtime-base:check"],
    tags = ["manual"],
)

oci_image(
    name = "runtime",
    base = ":runtime_base",
    cmd = ["talon-server"],
    entrypoint = [],
    env = {
        "TALON_DATA_DIR": "/data/talon",
        "RUST_LOG": "info",
    },
    exposed_ports = [
        "50051",
        "8081",
    ],
    target_compatible_with = LINUX,
    tars = [
        ":runtime_configs",
        ":runtime_binaries",
    ],
    workdir = "/data/talon",
)

oci_image(
    name = "benchmark",
    base = PYTHON_BASE,
    cmd = ["talon-node"],
    entrypoint = [],
    env = {
        "TALON_DATA_DIR": "/data/talon",
        "RUST_LOG": "info",
    },
    target_compatible_with = LINUX,
    tars = [
        ":runtime_os",
        ":runtime_configs",
        ":benchmark_binaries",
    ],
    workdir = "/data/talon",
)

image_layer(
    name = "ui_assets",
    web = "//ui:dist",
)

image_layer(
    name = "nginx_config",
    files = {"nginx.conf": "etc/nginx/conf.d/default.conf"},
)

oci_image(
    name = "ui",
    base = NGINX_BASE,
    exposed_ports = ["3000"],
    tars = [
        ":nginx_config",
        ":ui_assets",
    ],
)

[oci_load(
    name = name + "_image",
    image = ":" + name,
    repo_tags = ["talon-" + ("bench-runtime" if name == "benchmark" else name) + ":dev"],
    target_compatible_with = [] if name == "ui" else LINUX,
) for name in [
    "runtime",
    "ui",
    "benchmark",
]]

[oci_push(
    name = name + "_push",
    image = ":" + name,
    repository = "ghcr.io/impalasys/talon-" + name,
    target_compatible_with = [] if name == "ui" else LINUX,
) for name in [
    "runtime",
    "ui",
]]

container_context(
    name = "acp_context",
    dockerfile = "codex-acp.Dockerfile",
)

py_binary(
    name = "acp_image",
    srcs = ["//tools/bazel:image_builder.py"],
    args = [
        "--context",
        "dockerfiles/acp_context",
        "--target",
        "acp-runtime",
    ],
    data = [":acp_context"],
    main = "//tools/bazel:image_builder.py",
    deps = ["@rules_python//python/runfiles"],
)

exports_files(["dev-jwt.env"])

debian_layer(
    name = "runtime_os",
    packages = "@runtime_os//:packages",
    target_compatible_with = LINUX,
)
