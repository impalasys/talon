load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":go_tools.bzl", "gofmt_binary")
load(":protoc.bzl", "protoc_binary")

exports_files([
    "Cargo.toml",
    "requirements.lock",
])

exports_files([
    "production.bzl",
])

protoc_binary(
    name = "protoc",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "python_packager",
    srcs = ["python_packager.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("hatchling")],
)

py_binary(
    name = "hatchling",
    main_module = "hatchling",
    visibility = ["//visibility:public"],
    deps = [
        requirement("hatchling"),
    ],
)

exports_files(["maven_install.json"])

gofmt_binary(
    name = "gofmt",
    visibility = ["//visibility:public"],
)

alias(
    name = "grpc_java",
    actual = select({
        "//:linux_x86_64": "@grpc_java_linux_x86_64//file:downloaded",
        "//:linux_arm64": "@grpc_java_linux_aarch_64//file:downloaded",
        "//:darwin_arm64": "@grpc_java_osx_aarch_64//file:downloaded",
        "//conditions:default": "@grpc_java_osx_x86_64//file:downloaded",
    }),
    visibility = ["//visibility:public"],
)

py_test(
    name = "image_configs_test",
    srcs = ["image_configs_test.py"],
    args = ["$(rootpath //dockerfiles:runtime_configs)"],
    data = ["//dockerfiles:runtime_configs"],
    deps = [requirement("pyyaml")],
)

py_binary(
    name = "checksums",
    srcs = ["checksums.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "release_archives_test",
    srcs = ["release_archives_test.py"],
    args = [
        "$(rootpath //:release-dist_runtime)",
        "$(rootpath //:release-dist_node)",
    ],
    data = [
        "//:release-dist_node",
        "//:release-dist_runtime",
    ],
    tags = ["manual"],
    deps = [requirement("pyyaml")],
)
